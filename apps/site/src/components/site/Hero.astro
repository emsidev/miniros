---
import { screens } from "../../content/home";
---

<section class="hero section" id="top">
  <div class="hero-copy">
    <p class="section-label">
      <span aria-hidden="true">✦</span> For pop-up sellers & small retail teams
    </p>
    <h1>
      Track profit,
      <span>not just sales.</span>
      <em aria-hidden="true">↗</em>
    </h1>
    <p class="hero-lede">Know if a booth is worth renting again.</p>
    <p class="hero-body">
      MINIROS helps you run every selling shift: sales, payments, inventory,
      staff costs, rent, transport, deductions, and closeout, so you can see the
      real profit or loss of every location.
    </p>

    <div class="hero-actions">
      <a class="button button-primary" href="#early-access">
        <span>Join early access</span>
        <small>Limited slots</small>
      </a>
      <a class="button button-secondary" href="#how-it-works">
        <span>See how it works</span>
        <span class="button-icon" aria-hidden="true">▶</span>
      </a>
    </div>

    <div class="hero-pills" aria-label="MINIROS product signals">
      <span>⚡ Mobile-first</span>
      <span>📡 Works offline</span>
      <span>🔄 Real-time sync</span>
      <span>🔒 Private by design</span>
    </div>
  </div>

  <div class="hero-visual" aria-label="MINIROS mobile and admin mockups">
    <div class="hero-visual-orb" aria-hidden="true"></div>

    <div class="hero-admin-card glass-card">
      <div class="mock-window-dots" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div>
        <p class="mock-eyebrow">Location Analysis</p>
        <h2>SM Megamall Bazaar</h2>
        <div class="verdict-line">
          <strong>Rent Again</strong>
          <span>82</span>
        </div>
        <div class="sparkline" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div class="mini-stat-grid">
          <div><span>Avg sales</span><strong>₱12,400</strong></div>
          <div><span>Avg costs</span><strong>₱7,300</strong></div>
          <div><span>Avg profit</span><strong>₱5,100</strong></div>
        </div>
      </div>
    </div>

    <figure class="hero-shot hero-shot-main tilt-left">
      <img
        src={screens.startShiftStock}
        alt="MINIROS start shift mobile screen"
        loading="eager"
      />
    </figure>

    <figure class="hero-shot hero-shot-side tilt-right">
      <img src={screens.sell} alt="MINIROS mobile POS screen" loading="lazy" />
    </figure>
  </div>
</section>
