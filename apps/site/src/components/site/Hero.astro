---
import { screens } from "../../content/home";
---

<section class="hero" id="top">
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-context">
        Built for selling locations, not storefront averages.
      </p>
      <h1>Track profit,<br /><span>not just sales.</span></h1>
      <p class="hero-lede">
        Know if the booth was worth renting—and whether to return.
      </p>
      <p class="hero-body">
        MINIROS connects sales, payments, stock, production, staff costs, rent,
        transport, deductions, and closeout on the same shift record.
      </p>
      <div class="hero-actions">
        <a class="button button-accent" href="#early-access"
          >Join early access</a
        >
        <a class="text-link" href="#how-it-works"
          >Follow the operating loop <span aria-hidden="true">↓</span></a
        >
      </div>
      <ul class="hero-signals" aria-label="Product characteristics">
        <li>Mobile-first</li>
        <li>Offline-aware</li>
        <li>Shift-centered</li>
      </ul>
    </div>

    <div class="hero-proof" aria-label="MINIROS product screens">
      <figure class="hero-shot hero-shot-main">
        <img
          src={screens.startShiftStock}
          alt="MINIROS mobile start-shift screen"
          loading="eager"
        />
      </figure>
      <figure class="hero-shot hero-shot-sell">
        <div class="live-device">
          <img
            src={screens.sell}
            alt="Implemented MINIROS mobile checkout with the order sheet open"
            loading="eager"
          />
        </div>
      </figure>
      <figure class="hero-shot hero-shot-profit">
        <img
          src={screens.locationAnalysis}
          alt="MINIROS location profitability analysis"
          loading="eager"
        />
      </figure>
    </div>
  </div>
</section>
