---
import { problemCards } from "../../content/home";
---

<section class="problem-band" id="problem">
  <div class="problem-copy reveal-target">
    <p class="section-label section-label-dark">
      <span aria-hidden="true">↯</span> The real problem
    </p>
    <h2>
      Sales are easy to count.
      <span>Profit is the hard part.</span>
    </h2>
    <p>
      Many sellers do not know if a location is actually profitable because
      costs, inventory, and staff are tracked in different places or not tracked
      at all.
    </p>
  </div>

  <div class="problem-grid">
    {
      problemCards.map((card, index) => (
        <article class={`problem-card problem-card-${index + 1} reveal-target`}>
          <span class="problem-icon" aria-hidden="true">{card.icon}</span>
          <h3>{card.title}</h3>
          <p>{card.body}</p>
        </article>
      ))
    }
  </div>
</section>
