---
import { navItems } from "../../content/home";
import BrandMark from "./BrandMark.astro";
---

<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="#top" aria-label="MINIROS home">
      <BrandMark variant="inverse" />
      <span>
        <strong>MINIROS</strong>
        <small>Mini Retail Operations System</small>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="header-cta" href="#early-access">Join early access</a>
  </div>
</header>
