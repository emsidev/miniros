---
import { metrics } from "../../content/home";
---

<section class="metrics-band section" aria-label="MINIROS pilot goals">
  <div class="reveal-target">
    <p class="section-label section-label-dark">
      <span aria-hidden="true">✹</span> Real numbers
    </p>
    <h2>
      Smarter shifts.
      <span>Stronger businesses.</span>
    </h2>
    <p>
      The goal is not just to process orders. The goal is to make better booth
      decisions and protect margins.
    </p>
  </div>

  <div class="metrics-grid">
    {
      metrics.map((item) => (
        <article class="metric-card reveal-target">
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </article>
      ))
    }
  </div>
</section>
