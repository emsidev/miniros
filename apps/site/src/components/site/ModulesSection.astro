---
import { modules } from "../../content/home";
---

<section class="modules section" id="features">
  <div class="modules-copy reveal-target">
    <p class="section-label">
      <span aria-hidden="true">✺</span> Built for real operations
    </p>
    <h2>
      Everything you need.
      <span>Nothing you do not.</span>
    </h2>
    <p>
      MINIROS brings daily operations into one simple, mobile-first system built
      for how small selling teams actually work.
    </p>
  </div>

  <div class="module-grid">
    {
      modules.map((item) => (
        <article class="module-card reveal-target">
          <span class="module-icon" aria-hidden="true">{item.icon}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
