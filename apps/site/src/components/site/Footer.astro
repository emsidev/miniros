---
import { navItems } from "../../content/home";
import BrandMark from "./BrandMark.astro";
const appUrl = import.meta.env.PUBLIC_APP_URL || "http://localhost:3000";
---

<footer class="site-footer" id="early-access">
  <div class="footer-cta">
    <div>
      <p class="section-context">Early access</p>
      <h2>Put the next location decision on a better record.</h2>
      <p>
        Create an early access account for your team. Offline shifts remain
        limited to verified pilot locations.
      </p>
    </div>
    <div class="waitlist-form">
      <a class="button button-accent" href={`${appUrl}/register`}
        >Create early access account</a
      >
      <small>Already registered? <a href={`${appUrl}/login`}>Sign in</a>.</small
      >
    </div>
  </div>

  <div class="footer-bottom">
    <a class="footer-brand" href="#top">
      <BrandMark variant="inverse" />
      <span>MINIROS</span>
    </a>
    <nav aria-label="Footer navigation">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <p>© 2026 MINIROS</p>
  </div>
</footer>
