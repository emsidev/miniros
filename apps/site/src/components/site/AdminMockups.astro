---
import { screens } from "../../content/home";
---

<section class="profit-band" id="profitability">
  <div class="profit-inner">
    <div class="profit-copy">
      <p class="section-context dark">The answer owners need</p>
      <h2>Turn a closed shift into a rent-again decision.</h2>
      <p>
        Review each location with sales, product cost, staff, rent, transport,
        and recorded deductions in the same profitability view.
      </p>
      <div class="verdict">
        <div>
          <span>Weekend Bazaar</span>
          <strong>₱11,240 profit</strong>
        </div>
        <b>Worth renting again</b>
      </div>
    </div>

    <div class="profit-screens">
      <figure>
        <img
          src={screens.locations}
          alt="MINIROS location profitability list"
          loading="lazy"
        />
      </figure>
      <figure>
        <img
          src={screens.locationAnalysis}
          alt="MINIROS detailed location profit analysis"
          loading="lazy"
        />
      </figure>
    </div>
  </div>
</section>
