---
import { adminScreens, screens } from "../../content/home";
---

<section class="admin-showcase section" id="admin">
  <div class="section-heading">
    <p class="section-label">Web app for admins</p>
    <h2>Admin controls for the work behind every booth.</h2>
    <p>
      Operators get the mobile POS flow. Admins get a desktop workspace for
      setup, staffing, inventory, deductions, reporting, and rent-again
      decisions.
    </p>
  </div>

  <div class="admin-layout">
    <div class="desktop-shell">
      <div class="desktop-topbar">
        <div class="mock-window-dots" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <strong>MINIROS Admin</strong>
        <span>Location Profitability</span>
      </div>

      <div class="desktop-body">
        <aside class="desktop-sidebar" aria-label="Admin navigation mockup">
          <span class="active">Dashboard</span>
          <span>Locations</span>
          <span>Inventory</span>
          <span>Shifts</span>
          <span>Costs</span>
          <span>Reports</span>
        </aside>

        <div class="desktop-content">
          <div class="admin-summary-grid">
            <article>
              <span>Today sales</span>
              <strong>₱18,420</strong>
              <small>+12% vs last shift</small>
            </article>
            <article>
              <span>Net profit</span>
              <strong>₱5,200</strong>
              <small>After rent and staff</small>
            </article>
            <article>
              <span>Closeout</span>
              <strong>5 / 6</strong>
              <small>One shift pending</small>
            </article>
          </div>

          <div class="admin-table-card">
            <div class="table-heading">
              <div>
                <span>Locations</span>
                <strong>Worth renting again</strong>
              </div>
              <em>Profit verdict</em>
            </div>
            <div class="admin-row good">
              <span>SM Megamall Bazaar</span>
              <strong>Rent again</strong>
              <em>₱5,100</em>
            </div>
            <div class="admin-row neutral">
              <span>Weekend Market</span>
              <strong>Watch costs</strong>
              <em>₱1,260</em>
            </div>
            <div class="admin-row poor">
              <span>Pop-up Stall C</span>
              <strong>Reconsider</strong>
              <em>-₱840</em>
            </div>
          </div>
        </div>
      </div>
    </div>

    <figure class="admin-phone-card">
      <img
        src={screens.locationAnalysis}
        alt="MINIROS admin mobile location profitability screen"
        loading="lazy"
      />
    </figure>
  </div>

  <div class="admin-card-grid">
    {
      adminScreens.map((screen) => (
        <article class="admin-feature-card">
          <span>{screen.label}</span>
          <strong>{screen.metric}</strong>
          <h3>{screen.title}</h3>
          <p>{screen.body}</p>
        </article>
      ))
    }
  </div>
</section>
