---
import AdminMockups from "../components/site/AdminMockups.astro";
import FaqSection from "../components/site/FaqSection.astro";
import Footer from "../components/site/Footer.astro";
import Header from "../components/site/Header.astro";
import Hero from "../components/site/Hero.astro";
import HowItWorks from "../components/site/HowItWorks.astro";
import MetricsSection from "../components/site/MetricsSection.astro";
import ModulesSection from "../components/site/ModulesSection.astro";
import ProblemSection from "../components/site/ProblemSection.astro";
import TrustBar from "../components/site/TrustBar.astro";
import { meta } from "../content/home";
import "../styles/home.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content="#101319" />
    <title>{meta.title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="page-shell">
      <div class="ambient ambient-a" aria-hidden="true"></div>
      <div class="ambient ambient-b" aria-hidden="true"></div>

      <Header />
      <Hero />
      <TrustBar />
      <ProblemSection />
      <HowItWorks />
      <ModulesSection />
      <AdminMockups />
      <MetricsSection />
      <FaqSection />
    </main>

    <Footer />
  </body>
</html>
