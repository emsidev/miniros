---
import AdminMockups from "../components/site/AdminMockups.astro";
import FaqSection from "../components/site/FaqSection.astro";
import Footer from "../components/site/Footer.astro";
import Header from "../components/site/Header.astro";
import Hero from "../components/site/Hero.astro";
import HowItWorks from "../components/site/HowItWorks.astro";
import ModulesSection from "../components/site/ModulesSection.astro";
import ProblemSection from "../components/site/ProblemSection.astro";
import TrustBar from "../components/site/TrustBar.astro";
import { meta } from "../content/home";
import "@miniros/ui/tokens.css";
import "../styles/home.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content="#111318" />
    <title>{meta.title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Outfit:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <Hero />
      <TrustBar />
      <ProblemSection />
      <HowItWorks />
      <ModulesSection />
      <AdminMockups />
      <FaqSection />
    </main>
    <Footer />
  </body>
</html>
