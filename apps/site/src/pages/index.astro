---
const title = "MINIROS | Track profit, not just sales.";
const description =
  "Mobile-first retail operations for pop-up sellers, kiosks, and bazaar teams. MINIROS helps you know if a location is worth renting again.";

const screens = {
  startShiftStock: "/Employee%20_%20Start%20Shift%201.png",
  startShiftFloat: "/Employee%20_%20Start%20Shift%202.png",
  shifts: "/Employee%20_%20Shifts.png",
  sell: "/Employee%20_%20Sell.png",
  locations: "/Admin%20_%20Location%20Profitability%201.png",
  locationAnalysis: "/Admin%20_%20Location%20Profitability%202.png",
};

const navItems = [
  { label: "How It Works", href: "#workflow" },
  { label: "What It Tracks", href: "#features" },
  { label: "Location Profit", href: "#profitability" },
  { label: "FAQs", href: "#faqs" },
];

const metrics = [
  { value: "Shift-by-shift", label: "profitability visibility" },
  { value: "Mobile-first", label: "operator and admin workflows" },
  { value: "One system", label: "sales, costs, stock, and closeout" },
];

const operatingSignals = [
  {
    title: "Sell with the full cost picture",
    body: "Sales, opening stock, cash float, rent, transport, and shift deductions all stay tied to the same operational record.",
  },
  {
    title: "Keep staff flows simple on the floor",
    body: "Employees see clean shift, sell, and production routes instead of bulky admin tooling built for office desks.",
  },
  {
    title: "Decide where to show up again",
    body: "Location performance is the product outcome: MINIROS makes 'rent again' versus 'reconsider' visible at a glance.",
  },
];

const workflowSteps = [
  {
    index: "01",
    title: "Open the shift with real starting context",
    body: "Operators set opening stock from production and confirm the cash float before the first sale lands.",
    image: screens.startShiftStock,
    alt: "MINIROS start shift opening stock screen",
  },
  {
    index: "02",
    title: "Lock in the float and start selling",
    body: "Cash on hand is captured up front so closeout math has a clean baseline instead of guessed reconciliation.",
    image: screens.startShiftFloat,
    alt: "MINIROS start shift cash float screen",
  },
  {
    index: "03",
    title: "Run a mobile-first POS during the shift",
    body: "The sell flow keeps current orders, payment method, and shift status in a single focused touch surface.",
    image: screens.sell,
    alt: "MINIROS mobile sell screen",
  },
  {
    index: "04",
    title: "Keep the team aligned on what is active next",
    body: "Schedules and assigned shifts stay visible to the employee without sending them through an admin dashboard.",
    image: screens.shifts,
    alt: "MINIROS employee shifts calendar screen",
  },
  {
    index: "05",
    title: "Review the locations that should stay in rotation",
    body: "Admins can scan every location by rent level, active status, and average profit without digging through reports first.",
    image: screens.locations,
    alt: "MINIROS locations profitability list",
  },
  {
    index: "06",
    title: "Turn closeout data into a verdict",
    body: "Each location resolves to a simple recommendation backed by margin, profit trend, and shift history.",
    image: screens.locationAnalysis,
    alt: "MINIROS location analysis verdict screen",
  },
];

const featureCards = [
  {
    title: "Mobile shift control",
    body: "Opening stock, cash float, and shift execution are designed for small teams working from phones in tight physical spaces.",
  },
  {
    title: "One operational ledger",
    body: "Inventory movement, payments, production, and closeout stay connected so profit is not reconstructed from separate tools later.",
  },
  {
    title: "Operator clarity",
    body: "Role-based routes keep the daily employee surface clean while admin users retain deeper controls in a separate management layer.",
  },
  {
    title: "Location decisions",
    body: "The strongest promise is practical: after a booth weekend, the owner can tell whether that place earned another rental.",
  },
];

const faqItems = [
  {
    question: "Who is MINIROS built for?",
    answer:
      "MINIROS is built for pop-up sellers, bazaar teams, booth sellers, kiosk operators, and small retail groups that need mobile-first shift operations.",
  },
  {
    question: "What makes it different from a basic POS?",
    answer:
      "A basic POS stops at sales. MINIROS keeps the whole shift intact: opening stock, float, production, costs, closeout, and location-level profitability.",
  },
  {
    question: "Is the employee flow separate from the admin flow?",
    answer:
      "Yes. Employees and operators get a simpler workspace for shifts, selling, and production, while admin users keep setup, reporting, and location analysis under admin routes.",
  },
  {
    question: "What is the main business question it answers?",
    answer:
      "The core question is whether a selling location actually made money and whether the owner should rent that location again.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111318" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="page-shell">
      <div class="ambient ambient-a"></div>
      <div class="ambient ambient-b"></div>

      <header class="site-header">
        <a class="wordmark" href="#top" aria-label="MINIROS home">
          <span class="wordmark-mark" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
          <span>MINIROS</span>
        </a>

        <nav class="site-nav" aria-label="Primary">
          {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>

        <a class="nav-cta" href="#cta">
          <span>See the flow</span>
          <span class="nav-cta-icon" aria-hidden="true">↗</span>
        </a>
      </header>

      <section class="hero section" id="top">
        <div class="hero-copy">
          <p class="hero-kicker">
            MINIROS helps operators run the shift and helps owners decide
            whether the location earned another day.
          </p>
          <h1>Track profit, not just sales.</h1>
          <p class="hero-body">
            Built for booths, bazaars, kiosks, and pop-up teams that need one
            mobile-first system for shift setup, selling, production, closeout,
            and location profitability.
          </p>

          <div class="hero-actions">
            <a class="button button-primary" href="#workflow">
              <span>Walk the workflow</span>
              <span class="button-icon" aria-hidden="true">↗</span>
            </a>
            <a class="button button-secondary" href="#profitability"
              >See location verdicts</a
            >
          </div>

          <div class="metric-row">
            {
              metrics.map((item) => (
                <div class="metric-pill">
                  <strong>{item.value}</strong>
                  <span>{item.label}</span>
                </div>
              ))
            }
          </div>
        </div>

        <div class="hero-stage reveal">
          <figure class="hero-phone hero-phone-main tilt-negative">
            <img
              src={screens.locationAnalysis}
              alt="Location analysis verdict in MINIROS"
              loading="eager"
            />
          </figure>

          <figure
            class="hero-phone hero-phone-side hero-phone-side-left tilt-positive"
          >
            <img
              src={screens.startShiftStock}
              alt="Start shift opening stock in MINIROS"
              loading="lazy"
            />
          </figure>

          <figure
            class="hero-phone hero-phone-side hero-phone-side-right tilt-positive"
          >
            <img src={screens.sell} alt="Sell flow in MINIROS" loading="lazy" />
          </figure>
        </div>
      </section>

      <section class="signal-band reveal">
        <div class="section-intro">
          <h2>
            Measure the whole selling shift, not just the checkout moment.
          </h2>
          <p>
            MINIROS stays focused on operational truth: what stock went out,
            what money came in, what the shift cost, and whether that location
            deserves another rental.
          </p>
        </div>

        <div class="signal-grid">
          {
            operatingSignals.map((item) => (
              <article class="signal-card">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="workflow section" id="workflow">
        <div class="workflow-heading">
          <p class="section-label">How MINIROS moves</p>
          <h2>From shift opening to rent-again decisions.</h2>
          <p>
            The page structure follows the product logic instead of generic
            feature marketing. Each step below maps to a real MINIROS screen and
            a real operating decision.
          </p>
        </div>

        <div class="workflow-shell">
          <div class="workflow-summary reveal">
            <div class="summary-card">
              <span class="summary-line"></span>
              <h3>Shift selling is the center of the product.</h3>
              <p>
                Employees need a fast surface. Owners need clean totals. MINIROS
                is built so the same operational flow supports both without
                turning the employee view into admin clutter.
              </p>
            </div>
          </div>

          <div class="workflow-list">
            {
              workflowSteps.map((step) => (
                <article class="workflow-card reveal" data-step>
                  <div class="workflow-card-copy">
                    <span class="workflow-index">{step.index}</span>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </div>

                  <figure class="workflow-shot">
                    <img src={step.image} alt={step.alt} loading="lazy" />
                  </figure>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="features section" id="features">
        <div class="section-intro reveal">
          <p class="section-label">What it tracks</p>
          <h2>One operating layer for mobile selling teams.</h2>
          <p>
            The MVP stays disciplined: shift selling, production, stock,
            closeout, and location profitability. Nothing here tries to act like
            a bloated all-purpose retail suite.
          </p>
        </div>

        <div class="feature-bento">
          <article class="bento-card bento-card-large reveal">
            <div class="bento-copy">
              <h3>
                Operators start with the exact stock and float they will work
                with.
              </h3>
              <p>
                That makes the first sale, the closeout, and the profitability
                report part of one chain instead of disconnected forms.
              </p>
            </div>

            <div class="bento-double">
              <img
                src={screens.startShiftStock}
                alt="Opening stock step in MINIROS"
                loading="lazy"
              />
              <img
                src={screens.startShiftFloat}
                alt="Cash float step in MINIROS"
                loading="lazy"
              />
            </div>
          </article>

          <article class="bento-card bento-card-dark reveal">
            <div class="bento-copy">
              <h3>Every shift should feel legible on a phone.</h3>
              <p>
                Clean filters, concise cards, and decisive calls to action
                matter more than loading the interface with enterprise dashboard
                noise.
              </p>
            </div>

            <img
              src={screens.shifts}
              alt="Employee shifts view in MINIROS"
              loading="lazy"
            />
          </article>

          <article class="bento-card reveal">
            <div class="feature-list">
              {
                featureCards.slice(0, 2).map((item) => (
                  <div>
                    <h3>{item.title}</h3>
                    <p>{item.body}</p>
                  </div>
                ))
              }
            </div>
          </article>

          <article class="bento-card reveal">
            <div class="feature-list">
              {
                featureCards.slice(2).map((item) => (
                  <div>
                    <h3>{item.title}</h3>
                    <p>{item.body}</p>
                  </div>
                ))
              }
            </div>
          </article>
        </div>
      </section>

      <section class="profitability section" id="profitability">
        <div class="profit-shell">
          <div class="profit-copy reveal">
            <p class="section-label section-label-dark">
              Location profitability
            </p>
            <h2>A location should earn its next rent.</h2>
            <p>
              MINIROS turns shift history into a location verdict that a
              business owner can actually act on: rent again, reconsider, or
              rotate out.
            </p>

            <div class="profit-stats">
              <div>
                <span class="stat-value">42%</span>
                <span class="stat-label"
                  >sample profit margin surfaced in the UI</span
                >
              </div>
              <div>
                <span class="stat-value">82</span>
                <span class="stat-label"
                  >location score that compresses the decision</span
                >
              </div>
              <div>
                <span class="stat-value">3 views</span>
                <span class="stat-label"
                  >list, verdict, and shift history working together</span
                >
              </div>
            </div>
          </div>

          <div class="profit-visual reveal">
            <figure class="profit-device profit-device-back">
              <img
                src={screens.locations}
                alt="Locations list in MINIROS"
                loading="lazy"
              />
            </figure>
            <figure class="profit-device profit-device-front">
              <img
                src={screens.locationAnalysis}
                alt="Location analysis details in MINIROS"
                loading="lazy"
              />
            </figure>
          </div>
        </div>
      </section>

      <section class="faq section" id="faqs">
        <div class="section-intro reveal">
          <p class="section-label">FAQs</p>
          <h2>Built around daily pop-up retail work.</h2>
          <p>
            The messaging stays narrow on purpose. MINIROS is not pretending to
            solve every retail workflow in one release.
          </p>
        </div>

        <div class="faq-shell">
          <div class="faq-list reveal">
            {
              faqItems.map((item, index) => (
                <details class="faq-item" open={index === 0}>
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </details>
              ))
            }
          </div>

          <figure class="faq-shot reveal">
            <img
              src={screens.sell}
              alt="MINIROS sell sheet on mobile"
              loading="lazy"
            />
          </figure>
        </div>
      </section>

      <section class="cta section" id="cta">
        <div class="cta-card reveal">
          <div>
            <h2>
              Mobile-first operations for the booths that need clean profit
              answers.
            </h2>
            <p>
              MINIROS is designed for teams that want to sell fast, close
              cleanly, and know which location deserves the next booking.
            </p>
          </div>

          <div class="cta-actions">
            <a class="button button-primary" href="#top">
              <span>Back to top</span>
              <span class="button-icon" aria-hidden="true">↑</span>
            </a>
            <span class="cta-note">Track profit, not just sales.</span>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>MINIROS</span>
      <span
        >Mini Retail Operations System for shift selling and location profit.</span
      >
    </footer>

    <script>
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      const html = document.documentElement;
      const reduceMotionQuery = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );

      const activateFaqState = () => {
        document.querySelectorAll(".faq-item").forEach((item) => {
          item.toggleAttribute("data-open", item.open);
        });
      };

      activateFaqState();

      document.querySelectorAll(".faq-item").forEach((item) => {
        item.addEventListener("toggle", activateFaqState);
      });

      if (!reduceMotionQuery.matches) {
        html.classList.add("motion-safe");

        gsap.from(".site-header", {
          y: -24,
          opacity: 0,
          duration: 0.8,
          ease: "power3.out",
        });

        gsap.from(".hero-copy > *", {
          y: 28,
          opacity: 0,
          duration: 0.9,
          ease: "power3.out",
          stagger: 0.08,
          delay: 0.1,
        });

        gsap.from(".hero-phone", {
          y: 36,
          opacity: 0,
          rotate: 3,
          duration: 1.1,
          ease: "power3.out",
          stagger: 0.14,
          delay: 0.16,
        });

        const mm = gsap.matchMedia();

        mm.add(
          {
            isDesktop: "(min-width: 960px)",
            reduceMotion: "(prefers-reduced-motion: reduce)",
          },
          (context) => {
            const { reduceMotion } = context.conditions;

            if (reduceMotion) {
              return;
            }

            gsap.utils.toArray(".reveal").forEach((element) => {
              gsap.from(element, {
                y: 48,
                opacity: 0,
                duration: 0.9,
                ease: "power3.out",
                scrollTrigger: {
                  trigger: element,
                  start: "top 84%",
                },
              });
            });

            gsap.utils.toArray("[data-step]").forEach((card) => {
              const image = card.querySelector("img");
              gsap.from(card, {
                y: 44,
                opacity: 0,
                duration: 0.85,
                ease: "power3.out",
                scrollTrigger: {
                  trigger: card,
                  start: "top 78%",
                },
              });

              if (image) {
                gsap.fromTo(
                  image,
                  { scale: 0.92, y: 12 },
                  {
                    scale: 1,
                    y: 0,
                    duration: 1.1,
                    ease: "power3.out",
                    scrollTrigger: {
                      trigger: card,
                      start: "top 78%",
                      scrub: 0.6,
                    },
                  },
                );
              }
            });

            const summaryCard = document.querySelector(".summary-card");
            if (summaryCard) {
              gsap.fromTo(
                summaryCard,
                { y: 0 },
                {
                  y: -28,
                  ease: "none",
                  scrollTrigger: {
                    trigger: ".workflow-shell",
                    start: "top 70%",
                    end: "bottom bottom",
                    scrub: true,
                  },
                },
              );
            }
          },
        );
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f4efe7;
    --bg-strong: #ece4d8;
    --surface: rgba(255, 255, 255, 0.76);
    --surface-strong: #fffdf8;
    --surface-dark: #111318;
    --surface-dark-soft: #1a1f26;
    --text: #151922;
    --muted: #5e6777;
    --line: rgba(17, 19, 24, 0.08);
    --line-dark: rgba(255, 255, 255, 0.08);
    --accent: #d8fb34;
    --accent-soft: rgba(216, 251, 52, 0.16);
    --accent-dark: #161b12;
    --success: #3fbe68;
    --danger: #e45454;
    --shadow: 0 30px 80px rgba(17, 19, 24, 0.08);
    --shadow-strong: 0 36px 90px rgba(17, 19, 24, 0.18);
    --radius-xl: 32px;
    --radius-lg: 24px;
    --radius-md: 18px;
    --content: min(1180px, calc(100vw - 32px));
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --ease-soft: cubic-bezier(0.32, 0.72, 0, 1);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-width: 320px;
    overflow-x: hidden;
    background:
      radial-gradient(
        circle at top left,
        rgba(216, 251, 52, 0.12),
        transparent 28%
      ),
      radial-gradient(
        circle at 85% 14%,
        rgba(17, 19, 24, 0.06),
        transparent 20%
      ),
      linear-gradient(180deg, #f6f1e8 0%, #f4efe7 40%, #f2ede4 100%);
    color: var(--text);
    font-family: "Outfit", system-ui, sans-serif;
  }

  img {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  summary {
    font: inherit;
  }

  .page-shell {
    position: relative;
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  .ambient {
    position: fixed;
    inset: auto auto 10% -8%;
    z-index: 0;
    width: 26rem;
    height: 26rem;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(24px);
    opacity: 0.2;
  }

  .ambient-a {
    background: radial-gradient(
      circle,
      rgba(216, 251, 52, 0.26) 0%,
      transparent 68%
    );
  }

  .ambient-b {
    inset: 10% -10% auto auto;
    background: radial-gradient(
      circle,
      rgba(21, 25, 34, 0.14) 0%,
      transparent 62%
    );
  }

  .section,
  .signal-band,
  .site-header,
  .site-footer {
    position: relative;
    z-index: 1;
    width: var(--content);
    margin: 0 auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.2rem 1.5rem;
    margin-top: 1rem;
    background: rgba(255, 253, 248, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 999px;
    backdrop-filter: blur(16px);
    box-shadow: 0 16px 40px rgba(17, 19, 24, 0.06);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .wordmark-mark {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 999px;
    background: var(--surface-dark);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.08);
  }

  .wordmark-mark span {
    position: absolute;
    display: block;
    width: 0.9rem;
    height: 1.35rem;
    border-radius: 999px;
    background: var(--accent);
  }

  .wordmark-mark span:first-child {
    transform: translateX(-0.3rem) rotate(18deg);
  }

  .wordmark-mark span:last-child {
    transform: translateX(0.3rem) rotate(-18deg);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    font-size: 0.98rem;
    color: var(--muted);
  }

  .site-nav a {
    transition: color 220ms var(--ease-out);
  }

  .site-nav a:hover {
    color: var(--text);
  }

  .nav-cta,
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-height: 3.5rem;
    padding: 0.65rem 0.8rem 0.65rem 1.35rem;
    border-radius: 999px;
    border: 1px solid transparent;
    transition:
      transform 180ms var(--ease-out),
      background-color 240ms var(--ease-out),
      color 240ms var(--ease-out),
      border-color 240ms var(--ease-out),
      box-shadow 240ms var(--ease-out);
  }

  .nav-cta {
    background: var(--surface-dark);
    color: #fff;
    box-shadow: 0 14px 30px rgba(17, 19, 24, 0.16);
  }

  .nav-cta-icon,
  .button-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    transition:
      transform 220ms var(--ease-soft),
      background-color 220ms var(--ease-out);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 3rem;
    align-items: center;
    min-height: max(46rem, calc(100dvh - 8.5rem));
    padding: 5rem 0 4.5rem;
  }

  .hero-copy {
    max-width: 42rem;
  }

  .hero-kicker {
    max-width: 33rem;
    margin: 0 0 1.2rem;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.7;
  }

