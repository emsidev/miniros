{
  "extends": "../web/tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "baseUrl": "../web",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src/**/*.ts",
    "browser/**/*.ts",
    "browser/**/*.mts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules"]
}
