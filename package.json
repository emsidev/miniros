{
  "name": "miniros",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.2.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "pnpm --filter @miniros/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @miniros/e2e test",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "supabase db push",
    "db:migrate:local": "supabase migration up --local",
    "db:studio": "drizzle-kit studio --config ./drizzle.config.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,css,astro}": "pnpm exec prettier --write"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^22.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.25",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.1",
    "prettier-plugin-astro": "^0.14.1",
    "supabase": "2.116.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "postcss@>=8.0.0 <8.5.23": "8.5.28",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "browserslist@>=4.0.0 <4.28.7": "4.28.9",
      "fast-uri@>=3.0.0 <3.1.6": "3.1.7",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.2",
      "brace-expansion@>=1.0.0 <1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "undici@>=6.0.0 <6.28.0": "6.28.1",
      "qs@>=6.0.0 <6.16.0": "6.16.0",
      "svgo@>=4.0.0 <4.0.2": "4.1.0",
      "@xmldom/xmldom@>=0.9.0 <0.9.12": "0.9.12",
      "yaml@>=2.0.0 <2.8.3": "2.9.0"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
