{
  "name": "@miniros/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --no-fixed-extension --target es2022 --dts --out-dir dist --clean",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo No db tests yet",
    "db:generate": "pnpm --dir ../.. db:generate",
    "db:migrate": "pnpm --dir ../.. db:migrate",
    "db:studio": "pnpm --dir ../.. db:studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  }
}
