{
  "name": "@miniros/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "tokens:generate": "node scripts/tokens.mjs write",
    "tokens:check": "node scripts/tokens.mjs check",
    "build": "pnpm tokens:check && tsdown src/index.ts --format esm --no-fixed-extension --target es2022 --dts --out-dir dist --clean",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm tokens:check"
  }
}
