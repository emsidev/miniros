{
  "name": "@miniros/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./permissions": "./src/permissions.ts",
    "./workflows": "./src/workflows.ts"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --no-fixed-extension --target es2022 --dts --out-dir dist --clean",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
